# Copy to .env.local for local work. Never commit real values.
SHOPIFY_STORE_DOMAIN=projectbeej-1686bmnd.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_CHECKOUT_HOSTS=
# Dev Dashboard Admin app credentials. Server-only; the app exchanges these for
# short-lived Admin API tokens and refreshes them automatically.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Optional, server-only Storefront private token (must be a Storefront token, not an Admin shpat_ token).
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Optional webhook signing-secret override. Defaults to SHOPIFY_ADMIN_CLIENT_SECRET.
SHOPIFY_TRACKING_WEBHOOK_SECRET=
SHOPIFY_CHECKOUT_ORIGINS=
SHOPIFY_MODE=preview
SITE_URL=
NEXT_PUBLIC_SITE_URL=
# Set to 1 only after the Shopify shipping profile matches the merchant-approved rates.
SHOPIFY_SHIPPING_CONFIGURED=0

# All integrations remain off until brand-owned test/live IDs and the separate Supabase project are configured.
NEXT_PUBLIC_TRACKING_MODE=off
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TEST_GTM_ID=
NEXT_PUBLIC_TEST_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_TEST_META_PIXEL_ID=
GA4_API_SECRET=
GA4_TEST_API_SECRET=
META_CAPI_ACCESS_TOKEN=
META_TEST_CAPI_ACCESS_TOKEN=
META_CAPI_VERSION=
META_TEST_CAPI_VERSION=
TRACKING_SIGNING_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
